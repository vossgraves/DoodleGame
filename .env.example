# Postgres connection string for the accounts API.
# Set this as a secret in your host's environment — never commit the real value.
#
# Neon gives you one on the project dashboard; it looks like:
#   postgresql://USER:PASSWORD@ep-something.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Apply the schema once before first use:
#   psql "$DATABASE_URL" -f db/schema.sql
